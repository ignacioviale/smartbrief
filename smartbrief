  const [satTs,setSatTs]=useState(Date.now());
  const [wxData,setWxData]=useState(null);
  const [metarData,setMetarData]=useState(null);
  const [wxLoad,setWxLoad]=useState(false);
  const [wxErr,setWxErr]=useState("");
  const [err,setErr]=useState("");
  const planRef=useRef(), rosterRef=useRef();

  const toB64 = f => new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result.split(",")[1]); r.onerror=rej; r.readAsDataURL(f); });
  const setF = (k,f) => { if(!f) return; setFiles(p=>({...p,[k]:f})); setFnames(p=>({...p,[k]:f.name})); };

  const analyze = async () => {
    if(!apiKey.trim()){setErr("Ingresá tu API key de Anthropic."); return;}
    if(!files.plan&&!files.roster){setErr("Cargá al menos un PDF."); return;}
    ANTHROPIC_KEY = apiKey.trim();
    setErr(""); setLoad(true);
    try{
      const content=[];
      for(const f of [files.plan,files.roster]) if(f){ const b=await toB64(f); content.push({type:"document",source:{type:"base64",media_type:"application/pdf",data:b}}); }
      content.push({type:"text",text:`Sos experto en documentos de aviación comercial argentina. Analizá los PDFs adjuntos.
Respondé ÚNICAMENTE con JSON válido, sin markdown ni texto adicional:
{"tramos":[{"numeroVuelo":"AR1234","origen":"AEP","destino":"COR","alternativa":"ROS","std":"09:15","sta":"10:35","horaPresentacion":"08:00","matricula":"LV-XXX","tipoAeronave":"Boeing 737-800","pasajeros":156}],"oxigeno":"22 min","tramosProximos":[{"origen":"COR","destino":"IGR","std":"11:30","sta":"13:00","pasajeros":120}],"tripulacion":[{"pos":"Captain","nombre":"García, Juan"},{"pos":"First Officer","nombre":"López, María"},{"pos":"TS","nombre":"Fernández, Carlos"}]}
Reglas: std=STD de cada tramo, sta=STA, horaPresentacion=report time primer tramo, oxigeno=campo OXYGEN del plan, pasajeros=columna Y de nómina. Tripulación: comandante->Captain, copiloto->First Officer, resto usar código exacto columna POS. Códigos IATA 3 letras. null para no encontrados. TODOS los tramos en orden cronológico.`});
      const res = await fetch(API_URL, {
        method:"POST", headers:{"Content-Type":"application/json","anthropic-beta":"pdfs-2024-08-06"},
        body:JSON.stringify({model:API_MODEL,max_tokens:1500,messages:[{role:"user",content}]})
      });
      if(!res.ok){ const e=await res.json(); throw new Error(e?.error?.message||`HTTP ${res.status}`); }
      const j=await res.json();
      if(!j?.content) throw new Error("Respuesta vacía");
      setData(extractJSON(j.content.map(i=>i.text||"").join("")));
      setPhase("select");
    }catch(e){ setErr(`Error: ${e.message}`); }
    finally{ setLoad(false); }
  };

  const getAptList = leg => [
    {code:leg.origen,role:"ORIGEN",color:C.acc},
    {code:leg.destino,role:"DESTINO",color:C.grn},
    leg.alternativa?{code:leg.alternativa,role:"ALTERNATIVA",color:C.warn}:null
  ].filter(a=>a&&a.code&&COORDS[a.code]);

  const fetchWeather = async leg => {
    setWxLoad(true); setWxData(null); setMetarData(null); setWxErr("");
    const apts = getAptList(leg);
    if(!apts.length){ setWxLoad(false); return; }
    try{
      const aptNames = apts.map(a=>`${ICAO[a.code]||a.code} (${apt(a.code)||a.code})`).join(", ");
      const raw = await callClaude(
        `Sos un sistema meteorológico aeronáutico. Proporcioná datos meteorológicos actuales estimados para estos aeropuertos: ${aptNames}.\n`+
        `Respondé ÚNICAMENTE con este JSON:\n`+
        `{"metars":{"SABE":{"raw":"SABE 171200Z 18010KT 9999 FEW020 18/10 Q1013 NOSIG","temp":18,"dewPoint":10,"windDir":180,"windSpd":10,"windGusts":null,"vis":9999,"cloudCode":"FEW","cloudBase":2000,"pressure":1013,"flightRule":"VFR","observed":"${new Date().toISOString()}"}}}`,
        false
      );
      const parsed = extractJSON(raw);
      const metarsData = parsed?.metars || {};
      setWxData(apts.map(({code,role,color})=>{
        const icao=ICAO[code]||code; const m=metarsData[icao]||{};
        return{code,role,color,name:apt(code),source:"Estimado",
          temp2m:m.temp??null,dewPoint:m.dewPoint??null,windSpd:m.windSpd??null,
          windDir:m.windDir??null,windGusts:m.windGusts??null,vis:m.vis??null,
          cloudCover:m.cloudCode??null,cloudBase:m.cloudBase??null,
          pressure:m.pressure??null,flightRule:m.flightRule??null,
          obsTime:m.observed??null,rawMetar:m.raw??null};
      }));
      const mm={};
      Object.entries(metarsData).forEach(([icao,m])=>{ mm[icao]={metar:{raw_text:m.raw,observed:m.observed}}; });
      setMetarData(mm);
    }catch(e){ setWxErr(`Error: ${e.message}`); }
    finally{ setWxLoad(false); }
  };

  const goTo = i => {
    const leg=data?.tramos?.[i]||{};
    setIdx(i); setChk(CHK_INIT); setSec("flight");
    setWxData(null); setMetarData(null); setWxErr(""); setPhase("dashboard");
    setTimeout(()=>fetchWeather(leg),100);
