              <div><div style={{fontSize:13,color:files[k]?C.acc:C.txt,fontWeight:500}}>{fnames[k]||"Seleccionar archivo..."}</div><div style={{fontSize:11,color:C.mut,marginTop:2}}>{desc}</div></div>
