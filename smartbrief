            </div>
            <div style={{color:C.mut,fontSize:22}}>›</div>
          </div>
        ))}
        {data.tripulacion&&data.tripulacion.length>0&&(
          <div style={{background:C.surf,border:`1px solid ${C.brd}`,borderRadius:14,padding:"18px 22px",marginTop:8}}>
            <div style={{fontSize:10,color:C.mut,letterSpacing:2.5,textTransform:"uppercase",fontWeight:700,marginBottom:14}}>Tripulación de vuelo</div>
            <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(200px,1fr))",gap:10}}>
              {data.tripulacion.map((m,i)=>(
                <div key={i} style={{background:C.surf2,borderRadius:10,padding:"10px 14px",border:`1px solid ${C.brd}`}}>
                  <div style={{fontSize:10,color:m.pos==="Captain"?C.acc:m.pos==="First Officer"?C.grn:C.mut,letterSpacing:1,textTransform:"uppercase",fontWeight:700,marginBottom:3}}>{m.pos}</div>
                  <div style={{fontSize:m.pos==="Captain"?15:13,fontWeight:m.pos==="Captain"?800:600,color:C.txt}}>{m.nombre||"—"}</div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );

  // ── DASHBOARD ─────────────────────────────────────────────────────────
  const leg=data?.tramos?.[idx]||{};
  const nLegs=data?.tramos?.length||1;
  const reportTime=data?.tramos?.[0]?.horaPresentacion||null;
  const horaEmbarque=addMin(leg.std,-39);
  const maxSvc=maxSvcMins(reportTime,nLegs);
  const ultimoAterrizaje=maxSvc?addMin(reportTime,maxSvc):null;
  const ultimoAterRec=maxSvc?addMin(reportTime,maxSvc-15):null;
  const svcTotal=(toMins(ultimoAterrizaje)!==null&&toMins(reportTime)!==null)?fmtDur(((toMins(ultimoAterrizaje)-toMins(reportTime)+1440)%1440)):null;
  const allChk1=CHK1.every(c=>chk[c.k]);
  const allChk=CHK1.concat(CHK2).every(c=>chk[c.k]);
  const originCoords=leg.origen&&COORDS[leg.origen]?COORDS[leg.origen]:[-34,-64];
  const windyBase=`https://embed.windy.com/embed2.html?lat=${originCoords[0]}&lon=${originCoords[1]}&zoom=5&level=surface&menu=&message=true&marker=&calendar=now&pressure=&type=map&location=coordinates&detail=&metricWind=kt&metricTemp=%C2%B0C&radarRange=-1`;

  const ChkItem=({k,label,icon})=>(
    <div onClick={()=>setChk(p=>({...p,[k]:!p[k]}))} style={{display:"flex",alignItems:"center",gap:14,padding:"12px 14px",borderRadius:10,cursor:"pointer",marginBottom:8,background:chk[k]?"rgba(34,211,164,0.06)":"rgba(255,255,255,0.02)",border:`1px solid ${chk[k]?"rgba(34,211,164,0.3)":C.brd}`,transition:"all 0.15s"}}>
      <div style={{width:22,height:22,borderRadius:6,flexShrink:0,border:`2px solid ${chk[k]?C.grn:C.brd}`,background:chk[k]?C.grn:"transparent",display:"flex",alignItems:"center",justifyContent:"center",fontSize:13,color:"#000",fontWeight:800}}>{chk[k]?"✓":""}</div>
      <span style={{fontSize:18}}>{icon}</span>
      <span style={{fontSize:14,fontWeight:500,color:chk[k]?C.grn:C.txt}}>{label}</span>
    </div>
  );

  return(
    <div style={{minHeight:"100vh",background:C.bg,fontFamily:"system-ui,sans-serif",color:C.txt}}>
      <div style={{background:C.surf,borderBottom:`1px solid ${C.brd}`,padding:"13px 22px",display:"flex",alignItems:"center",justifyContent:"space-between"}}>
        <div style={{display:"flex",alignItems:"center",gap:14}}>
          <button onClick={()=>setPhase("select")} style={{background:"transparent",border:`1px solid ${C.brd}`,borderRadius:8,color:C.mut,padding:"5px 12px",cursor:"pointer",fontSize:12}}>← Tramos</button>
          {airline&&<img src={logoUrl(airline.iata)} alt={airline.name} onError={e=>e.target.style.display="none"} style={{height:28,objectFit:"contain",filter:"brightness(0) invert(1)"}}/>}
          <div>
            <span style={{fontSize:10,color:C.mut,letterSpacing:3,fontWeight:600}}>SMARTBRIEF{airline?` · ${airline.name}`:""} · </span>
            <span style={{fontSize:15,fontWeight:800,fontFamily:"monospace",color:C.acc}}>{leg.numeroVuelo||"—"}</span>
            <span style={{fontSize:13,color:C.mut,marginLeft:8}}>{apt(leg.origen)} → {apt(leg.destino)}</span>
          </div>
        </div>
        <div style={{fontSize:11,color:C.mut,fontFamily:"monospace"}}>{new Date().toLocaleString("es-AR",{hour:"2-digit",minute:"2-digit",day:"2-digit",month:"2-digit"})}</div>
      </div>
      <div style={{display:"flex",background:C.surf,borderBottom:`1px solid ${C.brd}`}}>
        {[["flight","✈  Dashboard de vuelo"],["weather","🌤  Info meteorológica"]].map(([k,lb])=>(
          <button key={k} onClick={()=>setSec(k)} style={{padding:"12px 22px",background:"transparent",border:"none",cursor:"pointer",color:sec===k?C.acc:C.mut,fontWeight:sec===k?700:400,fontSize:13,borderBottom:sec===k?`2px solid ${C.acc}`:"2px solid transparent"}}>{lb}</button>
        ))}
      </div>

      <div style={{padding:"20px 22px",maxWidth:900,margin:"0 auto"}}>
        {sec==="flight"?(
          <>
            <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr 1fr",gap:10,marginBottom:10}}>
              <InfoCard label="Vuelo" value={leg.numeroVuelo} accent/>
              <InfoCard label="Origen" value={apt(leg.origen)} sub={leg.origen}/>
              <InfoCard label="Destino" value={apt(leg.destino)} sub={leg.destino}/>
              <InfoCard label="Alternativa" value={apt(leg.alternativa)} sub={leg.alternativa}/>
            </div>
            <div style={{display:"grid",gridTemplateColumns:"2fr 1fr 1fr",gap:10,marginBottom:10}}>
              <InfoCard label="Tipo de aeronave" value={leg.tipoAeronave} mono={false}/>
              <InfoCard label="Matrícula" value={leg.matricula}/>
              <InfoCard label="Tiempo de oxígeno" value={data.oxigeno}/>
            </div>
            <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:10,marginBottom:10}}>
              <InfoCard label="Presentación (Report)" value={reportTime}/>
              <InfoCard label="Embarque de pasajeros" value={horaEmbarque} sub="STD − 39 min"/>
              <InfoCard label="Despegue (STD)" value={leg.std}/>
            </div>
            <div style={{marginBottom:10}}>
              <div style={{fontSize:10,color:C.mut,letterSpacing:2,textTransform:"uppercase",fontWeight:700,marginBottom:8}}>Tiempo de vuelo por tramo</div>
              <div style={{display:"grid",gridTemplateColumns:`repeat(${Math.min(data.tramos.length,4)},1fr)`,gap:10}}>
                {data.tramos.slice(0,4).map((t,i)=>{
                  const mins=diffMins(t.std,t.sta);
                  return(
                    <div key={i} style={{padding:"12px 14px",background:i===idx?"rgba(77,159,255,0.08)":C.surf2,borderRadius:10,border:`1px solid ${i===idx?C.acc+"66":C.brd}`}}>
                      <div style={{fontSize:10,color:C.mut,fontWeight:700,marginBottom:4}}>{t.origen||"—"} → {t.destino||"—"}</div>
                      <div style={{fontSize:14,fontWeight:700,fontFamily:"monospace",color:C.txt}}>{mins!==null?fmtDur(mins):"—"}</div>
