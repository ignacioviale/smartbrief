            style={{width:"100%",padding:"12px 16px",background:C.surf2,border:`1px solid ${apiKey?C.acc:C.brd}`,borderRadius:12,color:C.txt,fontSize:13,fontFamily:"monospace",outline:"none"}}
          />
          <div style={{fontSize:10,color:C.mut,marginTop:6,lineHeight:1.6}}>
            Obtenela en <a href="https://console.anthropic.com" target="_blank" style={{color:C.acc}}>console.anthropic.com</a> → API Keys. Se usa solo localmente, no se guarda en ningún servidor.
          </div>
        </div>
        <div style={{marginBottom:22}}>
          <div style={{fontSize:10,color:C.mut,marginBottom:7,letterSpacing:1.5,textTransform:"uppercase",fontWeight:700}}>Aerolínea</div>
