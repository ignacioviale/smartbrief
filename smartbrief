                  <iframe src={`${windyBase}&overlay=radar`} width="100%" height="100%" frameBorder="0" title="Radar" style={{display:"block"}}/>
                </div>
                <div style={{fontSize:10,color:C.mut,marginTop:8,textAlign:"right"}}>Fuente: Windy.com</div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(SmartBrief));
</script>
</body>
