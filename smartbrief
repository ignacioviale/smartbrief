        <div style={{fontSize:10,letterSpacing:5,color:C.acc,marginBottom:12,fontWeight:700}}>✈ SOLUCIONES AERONÁUTICAS ARGENTINAS</div>
        <div style={{fontSize:54,fontWeight:900,letterSpacing:-2,lineHeight:1}}>Smart<span style={{color:C.acc}}>Brief</span></div>
        <div style={{fontSize:13,color:C.mut,marginTop:12}}>Briefing digital para pilotos de línea aérea</div>
      </div>
      <div style={{background:C.surf,border:`1px solid ${C.brd}`,borderRadius:20,padding:40,width:"100%",maxWidth:500}}>
        <div style={{fontSize:10,color:C.mut,marginBottom:24,letterSpacing:2.5,textTransform:"uppercase",fontWeight:700}}>Configuración</div>

        {/* API Key */}
        <div style={{marginBottom:22}}>
          <div style={{fontSize:10,color:C.mut,marginBottom:7,letterSpacing:1.5,textTransform:"uppercase",fontWeight:700}}>🔑 Anthropic API Key</div>
          <input
