const toMins = t => { if(!t) return null; const m=t.match(/(\d{1,2})[:\s](\d{2})/); return m?parseInt(m[1])*60+parseInt(m[2]):null; };
const fmtT = m => { if(m==null) return null; const n=((m%1440)+1440)%1440; return `${String(Math.floor(n/60)).padStart(2,"0")}:${String(n%60).padStart(2,"0")}`; };
const addMin = (t,d) => { const b=toMins(t); return b!==null?fmtT(b+d):null; };
const diffMins = (a,b) => { const x=toMins(a),y=toMins(b); return x!==null&&y!==null?((y-x+1440)%1440):null; };
const fmtDur = m => m!==null?`${Math.floor(m/60)}h ${String(m%60).padStart(2,"0")}m`:null;
const windDir = d => { if(d==null) return "—"; return ["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSO","SO","OSO","O","ONO","NO","NNO"][Math.round(d/22.5)%16]; };
const visLabel = v => v==null?"—":v>=10000?"≥10 km":`${(v/1000).toFixed(1)} km`;
const maxSvcMins = (rt,segs=1) => { const h=toMins(rt); if(h===null) return null; const row=SVC_TABLE.find(r=>h>=r.from&&h<=r.to); return row?row.vals[Math.min(Math.max(segs-1,0),6)]*60:null; };

const extractJSON = str => {
  const findBlock = (s,open,close) => {
    const start=s.indexOf(open); if(start===-1) return null;
    let depth=0,inStr=false,esc=false;
    for(let i=start;i<s.length;i++){
      const c=s[i];
      if(esc){esc=false;continue;} if(c==='\\'&&inStr){esc=true;continue;}
      if(c==='"'){inStr=!inStr;continue;} if(inStr) continue;
      if(c===open) depth++; else if(c===close){depth--;if(depth===0) return s.slice(start,i+1);}
    } return null;
  };
  const obj=findBlock(str,'{','}'), arr=findBlock(str,'[',']');
  if(obj&&arr) return JSON.parse(str.indexOf('{') < str.indexOf('[') ? obj : arr);
  if(obj) return JSON.parse(obj); if(arr) return JSON.parse(arr);
  throw new Error("No se encontró JSON válido");
};

const API_URL = "https://api.anthropic.com/v1/messages";
const API_MODEL = "claude-sonnet-4-20250514";

// API key almacenada en memoria de sesión
let ANTHROPIC_KEY = "";

const callClaude = async (prompt, withSearch=false, extraHeaders={}) => {
  if (!ANTHROPIC_KEY) throw new Error("API key no configurada");
  extraHeaders["x-api-key"] = ANTHROPIC_KEY;
  const messages = [{role:"user", content:prompt}];
  const tools = withSearch ? [{type:"web_search_20250305",name:"web_search"}] : [];
  for(let i=0;i<6;i++){
    const body = {model:API_MODEL, max_tokens:2000, messages};
    if(tools.length) body.tools = tools;
    const res = await fetch(API_URL, {
      method:"POST", headers:{"Content-Type":"application/json",...extraHeaders},
      body:JSON.stringify(body)
    });
    if(!res.ok){ const e=await res.json(); throw new Error(e?.error?.message||`HTTP ${res.status}`); }
    const j = await res.json();
    if(!j?.content) throw new Error("Respuesta vacía");
    if(j.stop_reason==="end_turn") return j.content.filter(b=>b.type==="text").map(b=>b.text).join("");
    if(j.stop_reason==="tool_use"){
      messages.push({role:"assistant",content:j.content});
      const results = j.content.filter(b=>b.type==="tool_use").map(b=>({type:"tool_result",tool_use_id:b.id,content:"ok"}));
      messages.push({role:"user",content:results}); continue;
    }
    const txt = j.content.filter(b=>b.type==="text").map(b=>b.text).join("");
    if(txt) return txt;
    throw new Error(`stop_reason: ${j.stop_reason}`);
  }
  throw new Error("Demasiadas iteraciones");
};

