function SmartBrief() {
  const [apiKey,setApiKey]=useState("");
  const [phase,setPhase]=useState("upload");
  const [files,setFiles]=useState({plan:null,roster:null});
  const [fnames,setFnames]=useState({plan:"",roster:""});
