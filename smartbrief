              <div style={{fontSize:10,color:C.grn,letterSpacing:2,textTransform:"uppercase",fontWeight:700,marginBottom:10,marginTop:16,borderBottom:`1px solid ${C.brd}`,paddingBottom:6}}>2 — Briefing operacional</div>
              {CHK2.map(c=><ChkItem key={c.k} {...c}/>)}
              {allChk&&<div style={{marginTop:12,padding:"12px 16px",background:"rgba(34,211,164,0.08)",border:"1px solid rgba(34,211,164,0.25)",borderRadius:10,fontSize:14,color:C.grn,fontWeight:700,textAlign:"center"}}>✅ Briefing completo — ¡Listo para operar!</div>}
            </div>
          </>
        ):(
          <div>
            <div style={{display:"flex",gap:8,marginBottom:18,flexWrap:"wrap",alignItems:"center"}}>
              {[["meteo","🌡 Condiciones"],["metar","📋 METAR / TAF"],["satelite","🛰 Satélite"],["radar","📡 Radar"]].map(([k,lb])=>(
                <button key={k} onClick={()=>setWxSub(k)} style={{padding:"9px 18px",background:wxSub===k?C.acc:"transparent",border:`1px solid ${wxSub===k?C.acc:C.brd}`,borderRadius:20,color:wxSub===k?"#fff":C.mut,fontWeight:wxSub===k?700:400,fontSize:12,cursor:"pointer"}}>{lb}</button>
              ))}
              {wxLoad&&<span style={{fontSize:12,color:C.mut,marginLeft:"auto"}}>⏳ Cargando...</span>}
              {wxData&&!wxLoad&&(wxSub==="meteo"||wxSub==="metar")&&(
                <button onClick={()=>fetchWeather(leg)} style={{padding:"9px 14px",background:"transparent",border:`1px solid ${C.brd}`,borderRadius:20,color:C.mut,fontSize:11,cursor:"pointer",marginLeft:"auto"}}>🔄 Actualizar</button>
              )}
            </div>
            {wxErr&&<div style={{fontSize:12,color:"#f87171",padding:"10px 14px",background:"rgba(248,113,113,0.08)",borderRadius:8,border:"1px solid rgba(248,113,113,0.2)",marginBottom:14}}>{wxErr}</div>}

            {wxSub==="meteo"&&(
              !wxData?(
                <div style={{display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",minHeight:200,color:C.mut,textAlign:"center",background:C.surf,borderRadius:16,border:`1px solid ${C.brd}`}}>
                  <div style={{fontSize:36,marginBottom:10}}>⏳</div>
                  <div style={{fontSize:13,color:C.txt,fontWeight:600}}>Cargando condiciones meteorológicas...</div>
                </div>
              ):(
                <div style={{display:"grid",gridTemplateColumns:`repeat(${wxData.length},1fr)`,gap:12}}>
                  {wxData.map(w=>{
                    const frc=w.flightRule==="VFR"?C.grn:w.flightRule==="MVFR"?"#60a5fa":w.flightRule==="IFR"?C.warn:"#f87171";
                    return(
                      <div key={w.code} style={{background:C.surf,border:`1px solid ${w.color}33`,borderRadius:16,overflow:"hidden"}}>
                        <div style={{background:`linear-gradient(135deg,${w.color}18,${w.color}06)`,borderBottom:`1px solid ${C.brd}`,padding:"13px 16px",display:"flex",alignItems:"flex-start",justifyContent:"space-between"}}>
                          <div>
                            <div style={{fontSize:9,color:w.color,letterSpacing:2.5,fontWeight:700,marginBottom:3}}>{w.role}</div>
                            <div style={{fontSize:22,fontWeight:900,fontFamily:"monospace",color:C.txt}}>{w.code}</div>
                            <div style={{fontSize:11,color:C.mut,marginTop:1}}>{w.name}</div>
                          </div>
                          {w.flightRule&&<div style={{fontSize:11,fontWeight:800,color:frc,background:`${frc}22`,padding:"4px 10px",borderRadius:20,border:`1px solid ${frc}44`,marginTop:4}}>{w.flightRule}</div>}
                        </div>
                        <div style={{padding:"12px 14px",display:"grid",gridTemplateColumns:"1fr 1fr",gap:7}}>
                          {[
                            {lb:"Temp.",v:w.temp2m!=null?`${Number(w.temp2m).toFixed(1)} °C`:null,ic:"🌡"},
                            {lb:"Punto rocío",v:w.dewPoint!=null?`${Number(w.dewPoint).toFixed(1)} °C`:null,ic:"💧"},
                            {lb:"Viento",v:w.windSpd!=null?`${Number(w.windSpd).toFixed(0)} kt`:null,sb:w.windDir!=null?`${windDir(w.windDir)} ${Math.round(w.windDir)}°`:null,ic:"💨"},
                            {lb:"Ráfagas",v:w.windGusts!=null?`${Number(w.windGusts).toFixed(0)} kt`:null,ic:"🌬"},
                            {lb:"Visibilidad",v:w.vis!=null?(w.vis>=9999?"≥10 km":`${(w.vis/1000).toFixed(1)} km`):null,ic:"👁"},
                            {lb:"Nubes",v:w.cloudCover||null,sb:w.cloudBase!=null?`Base ${w.cloudBase} ft`:null,ic:"☁"},
                            {lb:"Presión",v:w.pressure!=null?`${Number(w.pressure).toFixed(0)} hPa`:null,ic:"📊"},
                            {lb:"Fuente",v:w.source||"Estimado",ic:"ℹ️"},
                          ].map(({lb,v,sb,ic})=>(
                            <div key={lb} style={{background:C.surf2,borderRadius:8,padding:"8px 10px",border:`1px solid ${C.brd}`}}>
                              <div style={{fontSize:9,color:C.mut,letterSpacing:1,textTransform:"uppercase",fontWeight:700,marginBottom:2}}>{ic} {lb}</div>
                              <div style={{fontSize:12,fontWeight:700,fontFamily:"monospace",color:v?C.txt:C.mut}}>{v||"—"}</div>
                              {sb&&<div style={{fontSize:9,color:C.mut,marginTop:1}}>{sb}</div>}
                            </div>
                          ))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )
            )}

            {wxSub==="metar"&&(
              !metarData?(
                <div style={{display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",minHeight:200,color:C.mut,textAlign:"center",background:C.surf,borderRadius:16,border:`1px solid ${C.brd}`}}>
                  <div style={{fontSize:36,marginBottom:10}}>⏳</div>
                  <div style={{fontSize:13,color:C.txt,fontWeight:600}}>Cargando METAR / TAF...</div>
                </div>
              ):(
                <div style={{display:"flex",flexDirection:"column",gap:14}}>
                  {getAptList(leg).map(({code,role,color})=>{
                    const icao=ICAO[code]; const wx=icao?metarData[icao]:null;
                    return(
                      <div key={code} style={{background:C.surf,border:`1px solid ${color}33`,borderRadius:14,overflow:"hidden"}}>
                        <div style={{background:`linear-gradient(135deg,${color}18,${color}06)`,borderBottom:`1px solid ${C.brd}`,padding:"11px 18px",display:"flex",alignItems:"center",gap:12}}>
                          <div style={{fontSize:9,color,letterSpacing:2.5,fontWeight:700}}>{role}</div>
                          <div style={{fontSize:18,fontWeight:900,fontFamily:"monospace",color:C.txt}}>{code}</div>
                          {icao&&<div style={{fontSize:11,color:C.mut}}>ICAO: {icao}</div>}
                          <div style={{fontSize:11,color:C.mut,marginLeft:"auto"}}>{apt(code)}</div>
                        </div>
                        <div style={{padding:"14px 18px"}}>
                          <div style={{fontSize:10,color:C.acc,letterSpacing:2,textTransform:"uppercase",fontWeight:700,marginBottom:6}}>METAR</div>
                          <div style={{fontFamily:"monospace",fontSize:12,color:C.txt,background:C.surf2,padding:"10px 14px",borderRadius:8,border:`1px solid ${C.brd}`,lineHeight:1.8,wordBreak:"break-all"}}>
                            {wx?.metar?.raw_text||"Sin datos disponibles"}
                          </div>
                          {wx?.metar?.observed&&<div style={{fontSize:10,color:C.mut,marginTop:5}}>Obs: {new Date(wx.metar.observed).toLocaleString("es-AR")}</div>}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )
            )}

            {wxSub==="satelite"&&(
              <div>
                <div style={{display:"flex",gap:8,marginBottom:12,flexWrap:"wrap",alignItems:"center"}}>
                  <div style={{display:"flex",gap:6}}>
                    {[["ssa","Sur (Argentina)"],["nsa","Norte (SA)"]].map(([k,lb])=>(
                      <button key={k} onClick={()=>setSatSector(k)} style={{padding:"7px 14px",background:satSector===k?C.acc:"transparent",border:`1px solid ${satSector===k?C.acc:C.brd}`,borderRadius:20,color:satSector===k?"#fff":C.mut,fontSize:11,cursor:"pointer",fontWeight:satSector===k?700:400}}>{lb}</button>
                    ))}
                  </div>
                  <div style={{display:"flex",gap:6}}>
                    {[["GEOCOLOR","GeoColor"],["Band13","IR"],["Band02","Visible"]].map(([k,lb])=>(
                      <button key={k} onClick={()=>setSatBand(k)} style={{padding:"7px 14px",background:satBand===k?"#334155":"transparent",border:`1px solid ${satBand===k?"#64748b":C.brd}`,borderRadius:20,color:satBand===k?C.txt:C.mut,fontSize:11,cursor:"pointer"}}>{lb}</button>
                    ))}
                  </div>
                  <button onClick={()=>setSatTs(Date.now())} style={{padding:"7px 14px",background:"transparent",border:`1px solid ${C.brd}`,borderRadius:20,color:C.mut,fontSize:11,cursor:"pointer",marginLeft:"auto"}}>🔄 Actualizar</button>
                </div>
                <div style={{borderRadius:14,overflow:"hidden",border:`1px solid ${C.brd}`,background:"#000"}}>
                  <img key={satTs} src={`https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/${satSector}/${satBand}/1200x1200.jpg?t=${satTs}`} alt="GOES-19" style={{width:"100%",display:"block",objectFit:"contain"}}
                    onError={e=>{e.target.style.display="none";e.target.nextSibling.style.display="flex";}}/>
                  <div style={{display:"none",flexDirection:"column",alignItems:"center",justifyContent:"center",minHeight:300,color:C.mut,padding:24,textAlign:"center"}}>
                    <div style={{fontSize:32,marginBottom:10}}>🛰</div>
                    <div style={{fontSize:13,color:C.txt,fontWeight:600,marginBottom:6}}>Imagen no disponible</div>
                    <a href={`https://www.star.nesdis.noaa.gov/goes/sector.php?sat=G19&sector=${satSector}`} target="_blank" rel="noopener noreferrer" style={{color:C.acc,fontSize:12}}>Ver en NOAA →</a>
                  </div>
                </div>
                <div style={{fontSize:10,color:C.mut,marginTop:8,textAlign:"right"}}>🛰 GOES-19 · NOAA/NESDIS · Actualización cada 10 min</div>
              </div>
            )}

            {wxSub==="radar"&&(
              <div>
                <div style={{fontSize:11,color:C.mut,marginBottom:10}}>📡 Radar meteorológico — centrado en {apt(leg.origen)||leg.origen}.</div>
