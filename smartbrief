  // ── UPLOAD ────────────────────────────────────────────────────────────
  if(phase==="upload") return(
    <div style={{minHeight:"100vh",background:C.bg,display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",fontFamily:"system-ui,sans-serif",color:C.txt,padding:24}}>
