        {data.tramos.map((t,i)=>(
          <div key={i} onClick={()=>goTo(i)} style={{background:C.surf,border:`1px solid ${C.brd}`,borderRadius:14,padding:"18px 22px",marginBottom:10,cursor:"pointer",display:"flex",alignItems:"center",gap:16}}
